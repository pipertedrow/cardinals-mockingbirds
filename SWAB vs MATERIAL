### Downstream Analysis ###
# create new folder for filtered table and data using the file scheme
mkdir -p /data/Desktop/Piper/UMGC_Data/Cristol_Project_001/all_samples/subset_pilotsamples/COMPARE

cd /data/Desktop/Piper/UMGC_Data/Cristol_Project_001/all_samples/subset_pilotsamples

# 1) Filter samples: keep ns and nm
qiime feature-table filter-samples \
  --i-table table-FINAL-no-blanks90k.qza \
  --m-metadata-file metadata_with_added_cols90k.tsv \
  --p-where "[sample type] in ('nm','ns')" \
  --o-filtered-table COMPARE/swab-vs-material-table90k.qza

# 2) Summaries (use the filtered table as input to keep scheme consistent)
qiime feature-table summarize \
  --i-table COMPARE/swab-vs-material-table90k.qza \
  --m-metadata-file metadata_with_added_cols90k.tsv \
  --o-summary COMPARE/swab-vs-material-table-vis90k.qzv \
  --o-feature-frequencies COMPARE/swab-vs-material-freq.qza \
  --o-sample-frequencies COMPARE/swab-vs-material-sample-freq.qza

# 3) Alpha rarefaction
qiime diversity alpha-rarefaction \
  --i-table COMPARE/swab-vs-material-table90k.qza \
  --i-phylogeny rooted-tree90k.qza \
  --p-max-depth 7000 \
  --m-metadata-file metadata_with_added_cols90k.tsv \
  --o-visualization COMPARE/swab-vs-material-alpha-rarefaction90k.qzv

# 4) Taxa barplot
qiime taxa barplot \
  --i-table COMPARE/swab-vs-material-table90k.qza \
  --i-taxonomy taxonomy90k-vsearch.qza \
  --m-metadata-file metadata_with_added_cols90k.tsv \
  --o-visualization COMPARE/swab-vs-material-barplot90k.qzv

# 5) Core metrics
qiime diversity core-metrics-phylogenetic \
  --i-table COMPARE/swab-vs-material-table90k.qza \
  --i-phylogeny rooted-tree90k.qza \
  --p-sampling-depth 7000 \
  --m-metadata-file metadata_with_added_cols90k.tsv \
  --p-n-jobs-or-threads 4 \
  --output-dir COMPARE/swab-vs-material-results

### Statistical Tests

qiime diversity alpha-group-significance \
  --i-alpha-diversity COMPARE/swab-vs-material-results/shannon_vector.qza \
  --m-metadata-file metadata_with_added_cols90k.tsv \
  --o-visualization COMPARE/swab-vs-material-results/shannon-group-significance.qzv

qiime diversity beta-group-significance \
  --i-distance-matrix COMPARE/swab-vs-material-results/jaccard_distance_matrix.qza \
  --m-metadata-file metadata_with_added_cols90k.tsv \
  --m-metadata-column "sample type" \
  --p-pairwise \
  --o-visualization COMPARE/swab-vs-material-results/jaccard-sampletype-significance.qzv


# -------------------- Differential Abundance --------------------

qiime composition ancombc2 \
  --i-table COMPARE/swab-vs-material/swab-vs-material-table90k.qza \
  --m-metadata-file metadata_with_added_cols90k.tsv \
  --p-fixed-effects-formula "species" \
  --p-reference-levels "species::mb" \
  --o-ancombc2-output COMPARE/swab-vs-material/ancombc2-species-results90k.qza

qiime composition ancombc2-visualizer \
  --i-data COMPARE/swab-vs-material/ancombc2-species-results90k.qza \
  --i-taxonomy taxonomy90k-vsearch.qza \
  --o-visualization COMPARE/swab-vs-material/ancombc2-species-barplot90k.qzv
