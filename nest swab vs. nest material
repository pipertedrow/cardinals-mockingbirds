--- Downstream Analysis ---
create new folder for filtered table and data 
mkdir -p /data/Desktop/Piper/UMGC_Data/Cristol_Project_001/all_samples/subset_pilotsamples/SWAB

cd /data/Desktop/Piper/UMGC_Data/Cristol_Project_001/all_samples/subset_pilotsamples/SWAB

Step 2) Filter table for nest swabs 
qiime feature-table filter-samples \
  --i-table table-FINAL-no-blanks90k.qza \
  --m-metadata-file metadata_with_added_cols90k.tsv \
  --p-where "[sample type] in ('ns')" \
  --o-filtered-table SWAB/swab-table90k.qza

Step 3) Visualize Filtered table 
qiime feature-table summarize \
  --i-table SWAB/swab-table90k.qza \
  --m-metadata-file metadata_with_added_cols90k.tsv \
  --o-summary SWAB/swab-table-vis90k.qzv \
  --o-feature-frequencies SWAB/swab-freq.qza \
  --o-sample-frequencies SWAB/swab-sample-freq.qza

Step 4) Alpha Rarfraction 
qiime diversity alpha-rarefaction \
    --i-table SWAB/swab-table90k.qza \
    --i-phylogeny rooted-tree90k.qza \
    --p-max-depth 10000 \
    --m-metadata-file metadata_with_added_cols90k.tsv \
    --o-visualization SWAB/swab-alpha-rarefaction90k.qzv

Step 5) Taxa Barplot 
qiime taxa barplot \
  --i-table SWAB/swab-table90k.qza \
  --i-taxonomy taxonomy90k-vsearch.qza \
  --m-metadata-file metadata_with_added_cols90k.tsv \
  --o-visualization SWAB/swab-barplot90k.qzv

Step 7) Core Metrics 
qiime diversity core-metrics-phylogenetic \
  --i-table SWAB/swab-table90k.qza \
  --i-phylogeny rooted-tree90k.qza \
  --p-sampling-depth 9000 \
  --m-metadata-file metadata_with_added_cols90k.tsv \
  --p-n-jobs-or-threads 4 \
  --output-dir SWAB/SWAB-results

--- Statistical Tests ---
now using the ns-nm-result folder. we can test different things 

qiime diversity alpha-group-significance \
    --i-alpha-diversity SWAB/SWAB-results/shannon_vector.qza \
    --m-metadata-file metadata_with_added_cols90k.tsv \
    --o-visualization SWAB/SWAB-results/shannon-group-significance.qzv

qiime diversity beta-group-significance \
  --i-distance-matrix SWAB/SWAB-results/bray_curtis_distance_matrix.qza \
  --m-metadata-file metadata_with_added_cols90k.tsv \
  --m-metadata-column "species" \
  --p-pairwise \
  --o-visualization SWAB/SWAB-results/bray_curtis-species-significance.qzv


# -------------------- Differential Abundance --------------------


## 2) Filter features (your original thresholds kept)
qiime feature-table filter-features \
  --i-table SWAB/swab-table90k.qza \
  --p-min-samples 5 \
  --p-min-frequency 20 \
  --o-filtered-table SWAB/filtered-ancom.qza


## 3) Add pseudocount
qiime composition add-pseudocount \
  --i-table SWAB/filtered-ancom.qza \
  --o-composition-table SWAB/comp-ancom.qza


# ---- OPTION 2 (prettier) ----

## 4) Run ANCOM-BC2
qiime composition ancombc2 \
  --i-table SWAB/swab-table90k.qza \
  --m-metadata-file metadata_with_added_cols90k.tsv \
  --p-fixed-effects-formula "species" \
  --p-reference-levels "species::mb" \
  --o-ancombc2-output SWAB/ancombc2-species-results90k.qza


## 5) Generate visualization
qiime composition ancombc2-visualizer \
  --i-data SWAB/ancombc2-species-results90k.qza \
  --i-taxonomy taxonomy90k-vsearch.qza \
  --o-visualization SWAB/ancombc2-species-barplot90k.qzv
