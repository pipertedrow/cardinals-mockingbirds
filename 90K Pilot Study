--- Fix Metadata Columns ---
python - << 'PY'
import pandas as pd
import re

inp = "manifest90k.tsv"
out = "metadata_with_added_cols90k.tsv"

df = pd.read_csv(inp, sep="\t")

blank_pat = re.compile(r"^blank-\d+$")          # blank-1, blank-2, ...
main_pat  = re.compile(r"^(?P<nest>\d{2})-(?P<stype>ns|nm|e)-(?P<sp>nc|mb)$")

def parse(s):
    s = str(s)
    main = s.split("_")[0]  # e.g., "02-e-mb" from "02-e-mb_S8"

    if blank_pat.match(main):
        # keep the blank id in nest number (or change to "" if you prefer)
        nest_number = main
        species = ""
        sample_type = ""
    else:
        m = main_pat.match(main)
        if m:
            nest_number = m.group("nest")
            sample_type = m.group("stype")
            species = m.group("sp")
        else:
            # fallback for unexpected patterns (won't crash)
            parts = main.split("-")
            nest_number = parts[0] if len(parts) > 0 else ""
            sample_type = parts[1] if len(parts) > 1 else ""
            species = parts[2] if len(parts) > 2 else ""

    return pd.Series([nest_number, species, sample_type])

df[["nest_number","species","sample_type"]] = df["sample-id"].apply(parse)

df = df.rename(columns={
    "nest_number": "nest number",
    "sample_type": "sample type"
})

df.to_csv(out, sep="\t", index=False)
print(f"Wrote: {out}")
PY

