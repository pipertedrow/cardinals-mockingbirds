--- Taxanomic Annotation ---
# Download pre-trimmed V4 references
wget https://data.qiime2.org/2024.10/common/silva-138-99-seqs-515-806.qza
wget https://data.qiime2.org/2024.10/common/silva-138-99-tax.qza

# Pre-trained classifier (optional shortcut)
wget https://data.qiime2.org/classifiers/sklearn-1.4.2/silva/silva-138-99-515-806-nb-classifier.qza

# Check QIIME2 resources page classifier list
wget https://data.qiime2.org/classifiers/sklearn-1.4.2/silva/silva-138-99-515-806-nb-classifier.qza

#3 Extract V4 region first
#based on 515F/806R primers same as tutorial
qiime feature-classifier extract-reads \
  --i-sequences silva-138-99-seqs-515-806.qza \
  --p-f-primer GTGYCAGCMGCCGCGGTAA \
  --p-r-primer GGACTACNVGGGTWTCTAAT \
  --p-min-length 100 \
  --p-max-length 400 \
  --o-reads silva138_V4_extracted.qza

#4 Train on smaller extracted reads
qiime feature-classifier fit-classifier-naive-bayes \
  --i-reference-reads silva138_V4_extracted.qza \
  --i-reference-taxonomy silva-138-99-tax.qza \
  --o-classifier silva138_V4_retrained_2026.4.qza

#5 Classify ASVs 
qiime feature-classifier classify-sklearn \
  --i-classifier silva138_V4_retrained_2026.4.qza \
  --i-reads asv-seqs90k-ms2.qza \
  --o-classification taxonomy90k.qza

#6 Taxa with Sequence Summary
qiime feature-table tabulate-seqs \
  --i-data asv-seqs90k-ms2.qza \
  --i-taxonomy taxonomy90k.qza \
  --o-visualization asv-seqs90k-ms2.qzv

