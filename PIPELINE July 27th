  --i-table eggshell_mockingbirdASV-table.qza \
  --p-min-samples 2 \

qiime feature-table filter-seqs \
  --i-data eggshell_mockingbirdASV-seqs.qza \
  --i-table eggshell_mockingbirdASV-table.qza \
  --o-filtered-data eggshell_mockingbirdASV-seqs-ms2.qza

