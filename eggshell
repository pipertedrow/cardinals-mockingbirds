cd /data/Desktop/Piper/UMGC_Data/Cristol_Project_001/all_samples/subset_pilotsamples/EGGSHELL

Step 2) Filtered Data  
qiime feature-table filter-samples \
  --i-table table-FINAL-no-blanks90k.qza \
  --m-metadata-file metadata_with_added_cols90k.tsv \
  --p-where "[sample type] in ('e')" \
  --o-filtered-table EGGSHELL/eggshell-table90k.qza

Step 3) Visualize Filtered table 
qiime feature-table summarize \
  --i-table EGGSHELL/eggshell-table90k.qza \
  --m-metadata-file metadata_with_added_cols90k.tsv \
  --o-summary EGGSHELL/eggshell-table-vis90k.qzv \
  --o-feature-frequencies EGGSHELL/EGG-freq.qza \
  --o-sample-frequencies EggSHELL/EGG-sample-freq.qza

Step 4) Alpha Rarfraction 
qiime diversity alpha-rarefaction \
    --i-table EGGSHELL/eggshell-table90k.qza \
    --i-phylogeny rooted-tree90k.qza \
    --p-max-depth 5000 \
    --m-metadata-file metadata_with_added_cols90k.tsv \
    --o-visualization EGGSHEll/egg-alpha-rarefaction90k.qzv

Step 5) Taxa Barplot 
qiime taxa barplot \
  --i-table EGGSHELL/eggshell-table90k.qza \
  --i-taxonomy taxonomy90k-vsearch.qza \
  --m-metadata-file metadata_with_added_cols90k.tsv \
  --o-visualization EGGSHELL/egg-barplot90k.qzv

Step 7) Core Metrics 
qiime diversity core-metrics-phylogenetic \
  --i-table EGGSHELL/eggshell-table90k.qza \
  --i-phylogeny rooted-tree90k.qza \
  --p-sampling-depth 5000 \
  --m-metadata-file metadata_with_added_cols90k.tsv \
  --p-n-jobs-or-threads 4 \
  --output-dir EGGSHELL/EGG-results

