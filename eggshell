--- Differential Abundance ---

qiime feature-table filter-features \
    --i-table eggshell-table90k.qza \
    --p-min-samples 5 \
    --p-min-frequency 20 \
    --o-filtered-table filtered-eggshell-table90k.qza

qiime composition add-pseudocount \
    --i-table filtered-decontam90k.qza \
    --o-composition-table comp-table-C6.qza

qiime feature-table filter-samples \
  --i-table comp-table-C6.qza \
  --m-metadata-file metadata_with_added_cols90k.tsv \
  --p-exclude-ids "blank-1_S59,blank-2_S60,blank-3_S61" \
  --o-filtered-table comp-table-C6-no-blanks.qza

qiime composition ancom \
    --i-table comp-table-C6-no-b.qza \
    --m-metadata-file metadata_no_blanks.tsv \
    --m-metadata-column species \
    --o-visualization ancom-C6-delivery.qzv
