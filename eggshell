Create Eggshell Table 
qiime feature-table filter-samples \
  --i-table comp-table-C6-no-blanks.qza \
  --m-metadata-file metadata_no_blanks.tsv \
  --p-where "[sample type] in ('e')" \
  --o-filtered-table eggshell-table90k.qza

Run Core Metrics for Eggshell 
qiime diversity core-metrics-phylogenetic \
  --i-table eggshell-table90k.qza \
  --i-phylogeny rooted-tree90k.qza \
  --p-sampling-depth 15000 \
  --m-metadata-file metadata_no_blanks.tsv \
  --p-n-jobs-or-threads 4 \
  --output-dir eggshell-results

Now using the result folder. we can test different things 

Generate shannon diversity sigificance 
qiime diversity alpha-group-significance \
    --i-alpha-diversity decontam-all-results/shannon_vector.qza \
    --m-metadata-file metadata_with_added_cols90k.tsv \
    --o-visualization decontam-all-results/shannon-group-significance.qzv

Generate beta diverrsity significance
qiime diversity beta-group-significance \
  --i-distance-matrix decontam-all-results/bray_curtis_distance_matrix.qza \
  --m-metadata-file metadata_with_added_cols90k.tsv \
  --m-metadata-column "sample type" \
  --p-pairwise \
  --o-visualization decontam-all-results/bray_curtis_sampletype-significance.qzv


