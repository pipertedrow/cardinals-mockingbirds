Create Eggshell Table 
qiime feature-table filter-samples \
  --i-table table-decontam90k.qza  \
  --m-metadata-file metadata_with_added_cols90k.tsv \
  --p-where "[sample type] in ('e')" \
  --o-filtered-table eggshell-table90k.qza

Run Core Metrics for Eggshell 
qiime diversity core-metrics-phylogenetic \
  --i-table eggshell-table90k.qza \
  --i-phylogeny rooted-tree90k.qza \
  --p-sampling-depth 15000 \
  --m-metadata-file metadata_with_added_cols90k.tsv \
  --p-n-jobs-or-threads 4 \
  --output-dir eggshell-results

Now using the result folder. we can test different things 

Generate shannon diversity sigificance 
qiime diversity alpha-group-significance \
    --i-alpha-diversity eggshell-results/shannon_vector.qza \
    --m-metadata-file metadata_with_added_cols90k.tsv \
    --o-visualization eggshell-results/shannon-group-significance.qzv

Generate beta diverrsity significance
qiime diversity beta-group-significance \
  --i-distance-matrix eggshell-results/bray_curtis_distance_matrix.qza \
  --m-metadata-file metadata_with_added_cols90k.tsv \
  --m-metadata-column "species" \
  --p-pairwise \
  --o-visualization eggshell-results/bray_curtis_species-significance.qzv

--- Differential Abundance ---

qiime feature-table filter-features \
    --i-table eggshell-table90k.qza \
    --p-min-samples 5 \
    --p-min-frequency 20 \
    --o-filtered-table filtered-eggshell-table90k.qza

qiime composition add-pseudocount \
    --i-table filtered-eggshell-table90k.qza \
    --o-composition-table filtered-eggshell-table90k.qza

qiime composition ancom \
    --i-table filtered-eggshell-table90k.qza \
    --m-metadata-file metadata_with_added_cols90k.tsv \
    --m-metadata-column species \
    --o-visualization ancom-eggshell-by-species.qzv

