  --m-metadata-file metadata_with_added_cols90k.tsv \
  --p-where "[species]='nc'" \
  --o-filtered-table EGGSHELL/egg_cardinal.qza


## 2) Filter features (your original thresholds kept)
qiime feature-table filter-features \
  --i-table EGGSHELL/eggshell-table90k.qza \
  --p-min-samples 5 \
  --p-min-frequency 20 \
  --o-filtered-table EGGSHELL/filtered-ancom.qza


## 3) Add pseudocount
qiime composition add-pseudocount \
  --i-table EGGSHELL/filtered-ancom.qza \
  --o-composition-table EGGSHELL/comp-ancom.qza


