  --i-demultiplexed-seqs paired-end-demux30k.qza \
  --p-trim-left-f 0 \
  --p-trim-left-r 0 \
  --p-trunc-len-f 240 \
  --p-trunc-len-r 180 \
  --p-n-threads 8 \
  --o-representative-sequences asv-seqs30k.qza \
  --o-table asv-table30k.qza \
  --o-denoising-stats denoising-stats30k.qza \
  --o-base-transition-stats base-transition-stats30k.qza \
  --verbose


