2) --- Create Manifest ---
Create the header first
echo -e "sample-id\tforward-absolute-filepath\treverse-absolute-filepath" > manifest.tsv

Then automatically add all your samples
for f in *_R1_001.fastq.gz; do
    sample="${f/_R1_001.fastq.gz/}"
    forward="$(pwd)/${f}"
    reverse="$(pwd)/${f/_R1_001.fastq.gz/_R2_001.fastq.gz}"
    echo -e "${sample}\t${forward}\t${reverse}" >> manifest.tsv
done

3) --- Visualize the Meta Data ---
qiime metadata tabulate \
  --m-input-file manifest.tsv \
  --o-visualization manifest.qzv

4) --- Demultiplex Data ---
# basically parses out and organizes files 
qiime tools import \
  --type 'SampleData[PairedEndSequencesWithQuality]' \
  --input-path manifest.tsv \
  --output-path paired-end-demux.qza \
  --input-format PairedEndFastqManifestPhred33V2

5) --- Visualize the Demultiplexed Data --- 
#after visualizing, determien the truncation lengths for DADA2 with the graphs generated 
qiime demux summarize \
  --i-data paired-end-demux.qza \
  --o-visualization paired-end-demux.qzv

6) --- Subset Data with Seqtk ---
#use visual histogram to see minimum number of reads per sample
#set seed to same for every file to randomly samples

#to download seqtk function
apt-get update && apt-get install -y seqtk

mkdir -p subset_allsamples

for r1 in *_R1_*.fastq.gz; do
r2=$(echo $r1 | sed 's/_R1_/_R2_/')
sample=$(echo $r1 | sed 's/_R1_.*//')

seqtk sample -s100 $r1 30000 | gzip > subset_allsamples/${sample}_R1_30k.fastq.gz
seqtk sample -s100 $r2 30000 | gzip > subset_allsamples/${sample}_R2_30k.fastq.gz
done

