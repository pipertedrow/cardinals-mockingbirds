  --i-table blank-table.qza \
  --p-min-frequency 1 \
  --o-filtered-table blank-features.qza

### export blank feature ids 
qiime tools export --input-path blank-features.qza --output-path blank-features-exported
biom convert -i blank-features-exported/feature-table.biom \
  -o blank-features-exported/feature-table.tsv --to-tsv
tail -n +3 blank-features-exported/feature-table.tsv | cut -f1 > blank-feature-ids.tsv
sed -i '1i Feature ID' blank-feature-ids.tsv

### remove contaminants from feature table 
