qiime feature-table filter-features \
  --i-table asv-table90k.qza \
  --p-min-samples 2 \
  --o-filtered-table asv-table90k-ms2.qza

qiime feature-table filter-seqs \
  --i-data asv-seqs90k.qza \
  --i-table asv-table90k-ms2.qza \
  --o-filtered-data asv-seqs90k-ms2.qza

--- Generate Phylogenetic Tree --- 

qiime phylogeny align-to-tree-mafft-fasttree \
  --i-sequences asv-seqs90k-ms2.qza \
  --o-alignment aligned-rep-seqs90k.qza \
  --o-masked-alignment masked-aligned-rep-seqs90k.qza \
  --o-tree unrooted-tree90k.qza \
  --o-rooted-tree rooted-tree90k.qza

--- Taxanomic Annotation ---

qiime feature-classifier classify-consensus-vsearch \
